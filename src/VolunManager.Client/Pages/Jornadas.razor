@page "/jornadas"
@inject ApiClient Api
<PageTitle>Jornadas</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Cliente distribuido</p>
        <h1>Jornadas</h1>
        <p>Listado obtenido desde VolunManager.Api.</p>
    </div>
    <button class="button primary" @onclick="Cargar">Actualizar</button>
</div>

<div class="form-card" style="margin-bottom: 2rem;">
    <h2>Agregar Jornada</h2>
    <div class="form-row">
        <div><label>Título</label><input type="text" @bind="nueva.Titulo" /></div>
        <div><label>Lugar</label><input type="text" @bind="nueva.Lugar" /></div>
    </div>
    <div class="form-row">
        <div><label>Fecha</label><input type="date" @bind="nueva.Fecha" /></div>
        <div><label>Horas Estimadas</label><input type="number" @bind="nueva.HorasEstimadas" min="1" /></div>
    </div>
    <div style="margin-top: 1rem;">
        <label>ID del Coordinador/Voluntario a cargo</label><input type="number" @bind="nueva.VoluntarioId" min="1" />
    </div>
    <button class="button primary" style="margin-top: 1rem;" @onclick="Crear">Guardar Jornada</button>
</div>

@if (cargando)
{
    <p class="status">Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{

    <div class="alert error">@error</div>
}
else if (items.Count == 0)
{

    <div class="empty">No hay jornadas registradas.</div>
}
else
{
    <div class="table-card">
        <table>
            <thead>
                <tr><th>ID</th><th>Título</th><th>Fecha</th><th>Lugar</th><th>Horas</th><th>Voluntario</th><th>Acción</th></tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Titulo</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@item.Lugar</td>
                        <td>@item.HorasEstimadas</td>
                        <td>@(item.NombreVoluntario ?? "Sin nombre")</td>
                        <td><button class="button secondary" style="color: red; border-color: red;" @onclick="() => Eliminar(item.Id)">Eliminar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<JornadaDto> items = [];
    private bool cargando = true;
    private string? error;

    private NuevaJornada nueva = new NuevaJornada { Fecha = DateTime.Today, HorasEstimadas = 4, VoluntarioId = 1 };

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true; error = null;
        var result = await Api.GetJornadasAsync();
        if (!result.Success) error = result.Message;
        else items = result.Data ?? [];
        cargando = false;
    }

    private async Task Crear()
    {
        if (string.IsNullOrWhiteSpace(nueva.Titulo) || string.IsNullOrWhiteSpace(nueva.Lugar))
        {
            error = "Título y Lugar son obligatorios."; return;
        }
        error = null; cargando = true;
        var result = await Api.CrearJornadaAsync(nueva);
        if (!result.Success) { error = result.Message; cargando = false; }
        else { nueva = new NuevaJornada { Fecha = DateTime.Today, HorasEstimadas = 4, VoluntarioId = 1 }; await Cargar(); }
    }

    private async Task Eliminar(int id)
    {
        error = null; cargando = true;
        var result = await Api.EliminarJornadaAsync(id);
        if (!result.Success) { error = result.Message; cargando = false; }
        else await Cargar();
    }

    private class NuevaJornada
    {
        public string Titulo { get; set; } = "";
        public string Lugar { get; set; } = "";
        public DateTime Fecha { get; set; }
        public int HorasEstimadas { get; set; }
        public int VoluntarioId { get; set; }
    }
}